# ============================================
# NMS Dashboard Configuration
# ============================================
# Copy this file to .env and fill in with your actual values
# Never commit .env to version control

# Telegram Bot Configuration
# Get from BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Dashboard Admin Credentials
# Use strong password: min 12 chars with symbols
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_strong_password_here

# Secret Key for Flask Sessions
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# Agent API Key for /api/agent/report endpoint
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=your_agent_api_key_here

# Security Settings
# Set to 1 if using HTTPS/behind SSL proxy
COOKIE_SECURE=0

# Monitoring Configuration
MAX_HOSTS=200
SNMP_VERSION=1

# Database backend: sqlite (default) or postgresql
DATABASE_BACKEND=sqlite
NMS_DB_PATH=/var/lib/nms/network.db
# Required when DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql://nms:change-me@postgres:5432/nms

# Process role: web disables scheduler; worker runs polling jobs
NMS_ROLE=worker

# Optional: Disable scheduler (for testing)
# NMS_DISABLE_SCHEDULER=0
