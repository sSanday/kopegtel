# NMS Kopegtel - contoh konfigurasi backend.
# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env
# File .env JANGAN dikomit ke repositori.

# Kunci rahasia sesi Flask. Wajib diisi dengan nilai acak yang panjang.
# Generate: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-dengan-string-acak

# Kunci Fernet untuk mengenkripsi kredensial SNMP/MikroTik/kanal di database. Wajib.
# Generate: py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Akun admin awal (dibuat otomatis saat pertama jalan jika tabel users kosong).
# Wajib minimal 10 karakter; pengguna wajib menggantinya pada login pertama.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-10-karakter

# Batasi target pemantauan ke daftar CIDR (opsional, pisah dengan koma).
# Contoh: ALLOWED_NETWORKS=192.168.0.0/16,10.0.0.0/8
# Bila kosong, pemindaian hanya boleh untuk rentang privat (RFC1918).
ALLOWED_NETWORKS=

# Port server Flask (opsional, default 5500).
PORT=5500
# Alamat bind (opsional, default 127.0.0.1). Gunakan 0.0.0.0 hanya di jaringan tepercaya.
HOST=127.0.0.1

# Ambang latency (ms) untuk menandai perangkat "degraded" (opsional, default 250).
DEGRADED_LATENCY_MS=250

# Versi aplikasi yang ditampilkan di halaman Laporan (opsional).
APP_VERSION=1.0.0

# Jumlah thread waitress (produksi; opsional, default 8).
WAITRESS_THREADS=8

# Level logging: DEBUG/INFO/WARNING/ERROR (opsional, default INFO). Log ke logs/nms.log (berputar 5 x 10 MB).
LOG_LEVEL=INFO

# Set 1 bila aplikasi diakses lewat HTTPS (mis. di belakang reverse proxy):
# cookie sesi menjadi Secure. Default 0 (HTTP lokal).
COOKIE_SECURE=0

# Set 1 HANYA bila aplikasi berada di belakang HTTPS: menambahkan header
# Strict-Transport-Security. Default 0.
HSTS_ENABLED=0

# Jumlah proxy tepercaya di depan aplikasi (0 bila langsung; mis. 1 bila lewat
# satu reverse proxy). IP klien diambil dari X-Forwarded-For untuk batas
# percobaan login dan audit_log. Default 0.
TRUSTED_PROXIES=0
