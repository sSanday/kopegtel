# Sesuaikan <path-proyek> dan <user-linux> sebelum install ke systemd.
[Unit]
Description=NMS KOPEGTEL Agent
After=network.target

[Service]
WorkingDirectory=<path-proyek>
EnvironmentFile=<path-proyek>/.env
ExecStart=<path-proyek>/env/bin/python nms-agent.py
Restart=always
RestartSec=10
User=<user-linux>

[Install]
WantedBy=multi-user.target
