[Unit]
Description=NMS KOPEGTEL Dashboard
After=network.target

[Service]
WorkingDirectory=/home/sandayy/nms-dashboard1
ExecStart=/home/sandayy/nms-dashboard1/env/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 app:app
# Pilih SALAH SATU metode jalan: Docker (aktif saat ini) ATAU systemd ini.
# Jangan aktifkan keduanya bersamaan (rebutan port 5000 + restart-loop).
# Tanda '-' agar service tak crash-loop bila .env belum ada; app akan
# memberi pesan error yang jelas soal SECRET_KEY.
EnvironmentFile=-/home/sandayy/nms-dashboard1/.env
Restart=always
RestartSec=5
User=sandayy

[Install]
WantedBy=multi-user.target
